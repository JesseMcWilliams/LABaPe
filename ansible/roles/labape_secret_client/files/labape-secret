#!/bin/sh
# labape-secret get NAME
# One of this VM's secrets from OpenBao (LABaPe V2, design §49.3): its own (owners stored it for this
# VM), else a shared one whose VM list names this VM. Signs in with the VM's platform certificate,
# whose key only root can read: run it as root (sudo). Prints the value; nothing else is written.
set -eu
[ "${1:-}" = get ] && [ -n "${2:-}" ] || { echo "usage: labape-secret get NAME" >&2; exit 2; }
NAME="$2"
case "$NAME" in [A-Za-z0-9]*) ;; *) echo "labape-secret: not a secret name: $NAME" >&2; exit 2 ;; esac
case "$NAME" in *[!A-Za-z0-9._-]*) echo "labape-secret: not a secret name: $NAME" >&2; exit 2 ;; esac
. /etc/labape/secret-client.conf
TLS=/etc/labape/tls
[ -r "$TLS/host.key" ] || { echo "labape-secret: can't read $TLS/host.key (run it as root)" >&2; exit 1; }
HDR="$(mktemp)"
trap 'rm -f "$HDR"' EXIT
chmod 600 "$HDR"
TOKEN="$(curl -fsS --cacert "$TLS/root.crt" --cert "$TLS/host.crt" --key "$TLS/host.key" \
  -H 'Content-Type: application/json' -d "{\"name\": \"$ROLE\"}" "$URL/v1/auth/cert/login" \
  | python3 -c 'import json, sys; print(json.load(sys.stdin)["auth"]["client_token"])')" \
  || { echo "labape-secret: OpenBao didn't sign this VM in" >&2; exit 1; }
printf 'X-Vault-Token: %s\n' "$TOKEN" > "$HDR"
found=1
for path in "env/$ENV/vm/$VM/$NAME" "env/$ENV/user/$NAME"; do
  if out="$(curl -fsS --cacert "$TLS/root.crt" -H @"$HDR" "$URL/v1/$MOUNT/data/$path" 2>/dev/null)"; then
    printf '%s' "$out" | python3 -c 'import json, sys; print(json.load(sys.stdin)["data"]["data"]["value"])'
    found=0
    break
  fi
done
curl -fsS --cacert "$TLS/root.crt" -H @"$HDR" -X POST "$URL/v1/auth/token/revoke-self" >/dev/null 2>&1 || true
[ "$found" = 0 ] || { echo "labape-secret: $NAME isn't there or this VM may not read it" >&2; exit 1; }
