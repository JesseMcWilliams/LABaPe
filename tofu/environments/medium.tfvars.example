# Claude_Docs/Design_System-Overview.md §9's "medium" profile — a dual-role DC (domain_controller +
# windows_server), extra Windows/Linux servers, and the first
# Windows-client (windows_11) and Debian-family (ubuntu_lts) workstation
# host groups, landing alongside that OS support (M5's deferred half).
#
# windows_11/ubuntu_lts are newer, less-exercised paths than the
# server/Rocky combination above them — see Claude_Docs/Testing_Troubleshooting-Log.md
# for real bugs found getting them working. ubuntu_lts still has an open
# unattended-storage bug there; swap in debian_latest for a Linux
# workstation that installs fully unattended today.
#
# Copy this to medium.tfvars and adjust before use — it's checked in as
# an example, not applied directly (.gitignore excludes real .tfvars).

host_groups = [
  {
    name  = "dc"
    count = 1
    os    = "windows_server_2022"
    roles = ["domain_controller", "windows_server"]
  },
  {
    name  = "winsrv"
    count = 2
    os    = "windows_server_2022"
    roles = ["windows_server"]
  },
  {
    name  = "linsrv"
    count = 3
    os    = "rocky9"
    roles = ["linux_server"]
  },
  {
    name  = "winws"
    count = 2
    os    = "windows_11"
    roles = ["windows_workstation"]
    # Windows 11 Setup rejects the 40 GB default (validate_os enforces
    # the 64 GB published minimum; see tofu/backends/libvirt/main.tf).
    disk_gb = 80
  },
  {
    name  = "linws"
    count = 2
    os    = "ubuntu_lts"
    roles = ["linux_workstation"]
  },
]
