# Subset of DESIGN.md §9's "small" profile. The full small profile also
# has a `dc` host group (roles = ["domain_controller"], DESIGN.md §8) —
# left out here since the domain_controller role itself isn't
# implemented yet (M4).
#
# winsrv below is real and works (M3 landed early for libvirt — see
# DESIGN.md §17 Open Question 5 and README's Known Gaps), but Windows
# Setup's own detection of the answer file is intermittently unreliable
# (~2 successes per 5 attempts observed, root cause not found despite
# extensive investigation) — comment it out if you'd rather not deal
# with retrying scripts/deploy.sh on an occasional failed attempt.
#
# Copy this to small.tfvars and adjust before use — it's checked in as
# an example, not applied directly (.gitignore excludes real .tfvars).

host_groups = [
  {
    name  = "linsrv"
    count = 2
    os    = "rocky9"
    roles = ["linux_server"]
  },
  {
    name  = "winsrv"
    count = 1
    os    = "windows_server_2022"
    roles = ["windows_server"]
  },
]
