# Claude_Docs/Design_System-Overview.md §9's "small" profile — a single-purpose DC (M4, Claude_Docs/Design_System-Overview.md
# §8), two Linux servers, one Windows member server.
#
# winsrv below is real and works (M3 landed early for libvirt — see
# Claude_Docs/Design_System-Overview.md §17 Open Question 5 and README's Known Gaps). It used to
# carry a caveat about intermittent answer-file failures; that's
# resolved as of README's Known Gaps round 10 (a multi-line XML comment
# in the answer-file template was tripping Windows Setup's XML
# deserializer) — no longer expected to need retries.
#
# Copy this to small.tfvars and adjust before use — it's checked in as
# an example, not applied directly (.gitignore excludes real .tfvars).

host_groups = [
  {
    name  = "dc"
    count = 1
    os    = "windows_server_2022"
    roles = ["domain_controller"]
  },
  {
    name  = "linsrv"
    count = 2
    os    = "rocky9"
    roles = ["linux_server"]
  },
  {
    name  = "winsrv"
    count = 1
    os    = "windows_server_2022"
    roles = ["windows_server"]
  },
]
