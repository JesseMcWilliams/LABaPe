# TLS in front of the LABaPe API, with the certificate from the platform CA
# (design §22.5): Caddy uses ACME against the labape-ca container. Select it
# with LABAPE_CADDYFILE=Caddyfile.labape-ca in container/.env. Browsers
# trust the LABaPe root (download it from the dashboard, /api/ca/root.crt).

{
	default_sni {$LABAPE_HOSTNAME}
}

{$LABAPE_HOSTNAME} {
	# An explicit issuer: Caddy otherwise never asks an ACME CA for an IP
	# address (step-ca issues for IP identifiers, RFC 8738).
	tls {
		issuer acme {
			dir https://labape-ca:9000/acme/acme/directory
			trusted_roots /labape-ca/certs/root_ca.crt
		}
	}
	encode gzip
	# The stack's mail (Mailpit's web UI), for signed-in admins only: LABaPe answers the check (design §52).
	handle /mail/* {
		forward_auth labape-api:8000 {
			uri /api/mail/auth
			header_up -X-LABaPe-Local
		}
		reverse_proxy labape-mailpit:8025 {
			flush_interval -1
		}
	}
	reverse_proxy labape-api:8000 {
		header_up -X-LABaPe-Local
		flush_interval -1
	}
}

# Authentik (design §47): the same name and certificate as the web interface, on port 9445, so
# browsers and linked stacks (which trust this platform CA) reach it over HTTPS.
https://{$LABAPE_HOSTNAME}:9445 {
	tls {
		issuer acme {
			dir https://labape-ca:9000/acme/acme/directory
			trusted_roots /labape-ca/certs/root_ca.crt
		}
	}
	reverse_proxy {$LABAPE_AUTHENTIK_UPSTREAM}
}

https://localhost:8443 {
	tls internal
	reverse_proxy labape-api:8000 {
		header_up X-LABaPe-Local 1
		flush_interval -1
	}
}
